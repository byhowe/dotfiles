#!/usr/bin/env bash

iDIR="$HOME/.config/mako/icons"

# Get Volume (0–100%)
get_volume() {
    wpctl get-volume @DEFAULT_AUDIO_SINK@ \
      | awk '{printf "%d\n", $2 * 100}'
}

# Get icons based on volume %
get_icon() {
    current=$(get_volume)
    if   (( current == 0 ));    then echo "$iDIR/volume-mute.png"
    elif (( current <= 30 ));   then echo "$iDIR/volume-low.png"
    elif (( current <= 60 ));   then echo "$iDIR/volume-mid.png"
    else                          echo "$iDIR/volume-high.png"
    fi
}

# Notify current volume
notify_user() {
    notify-send \
      -h string:x-canonical-private-synchronous:sys-notify \
      -a gui/osd \
      -u low \
      -i "$(get_icon)" \
      "Volume: $(get_volume)%"
}

# Increase Volume by 5%
inc_volume() {
    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && notify_user
}

# Decrease Volume by 5%
dec_volume() {
    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%- && notify_user
}

# Toggle Mute
toggle_mute() {
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '\[MUTED\]'; then
        notify-send \
          -h string:x-canonical-private-synchronous:sys-notify \
          -a gui/osd \
          -u low \
          -i "$iDIR/volume-mute.png" \
          "Volume Muted"
    else
        notify-send \
          -h string:x-canonical-private-synchronous:sys-notify \
          -a gui/osd \
          -u low \
          -i "$(get_icon)" \
          "Volume Unmuted"
    fi
}

# Toggle Mic Mute
toggle_mic() {
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q '\[MUTED\]'; then
        notify-send \
          -h string:x-canonical-private-synchronous:sys-notify \
          -a gui/osd \
          -u low \
          -i "$iDIR/microphone-mute.png" \
          "Microphone Muted"
    else
        notify-send \
          -h string:x-canonical-private-synchronous:sys-notify \
          -a gui/osd \
          -u low \
          -i "$iDIR/microphone.png" \
          "Microphone Unmuted"
    fi
}

# Get Mic volume icon (0–100%)
get_mic_icon() {
    current=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf "%d\n", $2 * 100}')
    if   (( current == 0 ));    then echo "$iDIR/microphone-mute.png"
    elif (( current <= 30 ));   then echo "$iDIR/microphone.png"
    elif (( current <= 60 ));   then echo "$iDIR/microphone.png"
    else                          echo "$iDIR/microphone.png"
    fi
}

# Notify current mic level
notify_mic_user() {
    level=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf "%d\n", $2 * 100}')
    notify-send \
      -h string:x-canonical-private-synchronous:sys-notify \
      -a gui/osd \
      -u low \
      -i "$(get_mic_icon)" \
      "Mic Level: ${level}%"
}

# Increase Mic Volume by 5%
inc_mic_volume() {
    wpctl set-volume -l @DEFAULT_AUDIO_SOURCE@ 5%+ && notify_mic_user
}

# Decrease Mic Volume by 5%
dec_mic_volume() {
    wpctl set-volume -l @DEFAULT_AUDIO_SOURCE@ 5%- && notify_mic_user
}

# Dispatch based on argument
case "$1" in
    --get)            get_volume ;;
    --inc)            inc_volume ;;
    --dec)            dec_volume ;;
    --toggle)         toggle_mute ;;
    --toggle-mic)     toggle_mic ;;
    --get-icon)       get_icon ;;
    --get-mic-icon)   get_mic_icon ;;
    --mic-inc)        inc_mic_volume ;;
    --mic-dec)        dec_mic_volume ;;
    *)                get_volume ;;
esac
